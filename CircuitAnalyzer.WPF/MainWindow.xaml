<Window x:Class="CircuitAnalyzer.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CircuitAnalyzer.WPF.Views"
        xmlns:controls="clr-namespace:CircuitAnalyzer.WPF.Controls"
        Title="Devre Analizi"
        Icon="pack://application:,,,/CircuitAnalyzer;component/Assets/app.ico"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource Window.App}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid x:Name="LayoutRoot">
            <Grid.RowDefinitions>
                <!-- Başlık: doğrudan Mica zemininin üstünde -->
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- Sol şerit: 5 eleman kategorisi -->
                <ColumnDefinition Width="72"/>
                <!-- Orta alan: devre çizim tuvali -->
                <ColumnDefinition Width="*"/>
                <!-- Ayırıcı: sağ panelin genişliği sürüklenerek ayarlanır -->
                <ColumnDefinition Width="8"/>
                <!-- Sağ panel: Analiz ayarları + sonuçlar (genişlik kullanıcıca ayarlanır, MainWindow.Layout.cs) -->
                <ColumnDefinition x:Name="AnalysisColumn" Width="460" MinWidth="360" MaxWidth="900"/>
                <ColumnDefinition Width="8"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════ -->
            <!-- BAŞLIK: ad, Dosya, Örnekler, Yeni soru     -->
            <!-- ═══════════════════════════════════════════ -->
            <Grid Grid.Row="0" Grid.ColumnSpan="5" Margin="18,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/CircuitAnalyzer;component/Assets/logo-128.png"
                           Width="20" Height="20"
                           Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Devre Analizi"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDocName"
                               Text="Adsız"
                               FontSize="14"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnFile"
                            Style="{DynamicResource Button.Ghost}"
                            Height="32"
                            Content="Dosya"
                            Click="BtnFile_Click"/>
                    <Button x:Name="BtnExamples"
                            Style="{DynamicResource Button.Ghost}"
                            Height="32"
                            Content="Örnekler"
                            Click="BtnExamples_Click"/>
                    <Button x:Name="BtnNewProblem"
                            Style="{DynamicResource Button.Ghost}"
                            Height="32"
                            Click="BtnNewProblem_Click"
                            ToolTip="Rastgele bir alıştırma sorusu üretir. Aynı soru kodu her bilgisayarda aynı devreyi verir.">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{DynamicResource Icon.Shuffle}" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Yeni soru" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="18"
                            Background="{DynamicResource Brush.Border.Default}"
                            Margin="8,0"/>
                    <Button x:Name="BtnHelp"
                            Style="{DynamicResource Button.Icon}"
                            Width="32" Height="32"
                            AutomationProperties.Name="Yardım"
                            Click="BtnHelp_Click">
                        <TextBlock Text="?"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
<!-- Tema: yazısız, üç simge (DESIGN.md, "Başlık çubuğu") -->
                    <Border x:Name="ThemeSwitch"
                            Style="{DynamicResource Segment.Track}"
                            Padding="2"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="BtnThemeLight"
                                          Style="{DynamicResource Toggle.ThemeIcon}"
                                          Tag="Light"
                                          ToolTip="Açık tema"
                                          AutomationProperties.Name="Açık tema"
                                          Click="ThemeSwitch_Click">
                                <controls:Icon Data="{DynamicResource Icon.Sun}" Width="16" Height="16"/>
                            </ToggleButton>
                            <ToggleButton x:Name="BtnThemeDark"
                                          Style="{DynamicResource Toggle.ThemeIcon}"
                                          Tag="Dark"
                                          ToolTip="Koyu tema"
                                          AutomationProperties.Name="Koyu tema"
                                          Click="ThemeSwitch_Click">
                                <controls:Icon Data="{DynamicResource Icon.Moon}" Width="16" Height="16"/>
                            </ToggleButton>
                            <ToggleButton x:Name="BtnThemeSystem"
                                          Style="{DynamicResource Toggle.ThemeIcon}"
                                          Tag="System"
                                          ToolTip="Windows'un ayarına uy"
                                          AutomationProperties.Name="Windows'un tema ayarına uy"
                                          Click="ThemeSwitch_Click">
                                <controls:Icon Data="{DynamicResource Icon.Monitor}" Width="16" Height="16"/>
                            </ToggleButton>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ═══════════════════════════════════════════ -->
            <!-- SOL ŞERİT: eleman kategorileri             -->
            <!-- ═══════════════════════════════════════════ -->
            <StackPanel x:Name="ElementRail" Grid.Row="1" Grid.Column="0" Margin="6,0,6,0">
                <ToggleButton x:Name="RailPassive"
                              Style="{DynamicResource Toggle.Rail}"
                              Tag="Pasif elemanlar"
                              AutomationProperties.Name="Pasif elemanlar"
                              Checked="RailButton_Checked"
                              Unchecked="RailButton_Unchecked">
                    <StackPanel>
                        <controls:Icon Data="{DynamicResource Icon.Resistor}" Width="22" Height="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="Pasif" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="RailSources"
                              Style="{DynamicResource Toggle.Rail}"
                              Tag="Kaynaklar"
                              AutomationProperties.Name="Kaynaklar"
                              Checked="RailButton_Checked"
                              Unchecked="RailButton_Unchecked">
                    <StackPanel>
                        <controls:Icon Data="{DynamicResource Icon.DcSource}" Width="22" Height="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="Kaynak" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="RailDependent"
                              Style="{DynamicResource Toggle.Rail}"
                              Tag="Bağımlı kaynaklar"
                              AutomationProperties.Name="Bağımlı kaynaklar"
                              Checked="RailButton_Checked"
                              Unchecked="RailButton_Unchecked">
                    <StackPanel>
                        <controls:Icon Data="{DynamicResource Icon.DepVcvs}" Width="22" Height="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="Bağımlı" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="RailSwitches"
                              Style="{DynamicResource Toggle.Rail}"
                              Tag="Anahtarlar"
                              AutomationProperties.Name="Anahtarlar"
                              Checked="RailButton_Checked"
                              Unchecked="RailButton_Unchecked">
                    <StackPanel>
                        <controls:Icon Data="{DynamicResource Icon.Switch}" Width="22" Height="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="Anahtar" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="RailMeasure"
                              Style="{DynamicResource Toggle.Rail}"
                              Tag="Ölçüm"
                              AutomationProperties.Name="Ölçüm"
                              Checked="RailButton_Checked"
                              Unchecked="RailButton_Unchecked">
                    <StackPanel>
                        <controls:Icon Data="{DynamicResource Icon.Probe}" Width="22" Height="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ölçüm" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>

            <!-- ═══════════════════════════════════════════ -->
            <!-- ORTA ALAN: DEVRE ÇİZİM TUVALİ              -->
            <!-- ═══════════════════════════════════════════ -->
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

            <!-- Ana çizim alanı: Card stili, Padding 0, ClipToBounds -->
            <Border Grid.Row="0"
                    x:Name="CanvasCard"
                    Style="{DynamicResource Card}"
                    Background="{DynamicResource Brush.Canvas.Bg}"
                    Effect="{x:Null}"
                    CornerRadius="8"
                    Padding="0"
                    ClipToBounds="True">
                <Grid x:Name="CanvasLayer">
                    <ScrollViewer x:Name="CanvasScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Focusable="False"
                                  PreviewMouseWheel="CanvasScrollViewer_PreviewMouseWheel"
                                  PreviewMouseDown="CanvasScrollViewer_PreviewMouseDown"
                                  PreviewMouseMove="CanvasScrollViewer_PreviewMouseMove"
                                  ContextMenuOpening="CanvasScrollViewer_ContextMenuOpening"
                                  MouseMove="CanvasScrollViewer_MouseMove"
                                  MouseUp="CanvasScrollViewer_MouseUp">
                        <ScrollViewer.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                        </ScrollViewer.Resources>
                        <Canvas x:Name="CircuitCanvas"
                                Width="4000" Height="3000"
                                Background="{DynamicResource Brush.Canvas.Grid}"
                                MouseLeftButtonDown="CircuitCanvas_MouseLeftButtonDown"
                                MouseMove="CircuitCanvas_MouseMove"
                                MouseLeftButtonUp="CircuitCanvas_MouseLeftButtonUp">
                            <Canvas.LayoutTransform>
                                <ScaleTransform x:Name="CanvasScaleTransform" ScaleX="1" ScaleY="1"/>
                            </Canvas.LayoutTransform>
                        </Canvas>
                    </ScrollViewer>

                    <!-- Boş çizim alanı yardımcısı -->
                    <Border x:Name="EmptyCanvasHelper"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            CornerRadius="20"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            Background="{DynamicResource Brush.Bg.Surface}"
                            Opacity="0.94"
                            Padding="32,28"
                            Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="56" Height="56"
                                    CornerRadius="14"
                                    Background="{DynamicResource Brush.Bg.SurfaceAlt}"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,14">
                                <controls:Icon Data="{DynamicResource Icon.Resistor}"
                                               Width="28" Height="28"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Henüz devre yok"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="Soldaki şeritten bir eleman ekleyin ya da hazır bir örnekle başlayın."
                                       Style="{DynamicResource Text.Caption}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,20"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{DynamicResource Button.Secondary}"
                                        Content="Örnek devre aç"
                                        Click="BtnExamples_Click"
                                        Margin="0,0,10,0"/>
                                <Button Style="{DynamicResource Button.Strong}"
                                        Content="Yeni soru"
                                        Click="BtnNewProblem_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Açılan eleman listesi: kategoriye tıklayınca tuvalin sol üstünde açılır -->
                    <Border x:Name="ElementDrawer"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="10"
                            Width="220"
                            CornerRadius="12"
                            Effect="{DynamicResource Effect.Glass}"
                            Panel.ZIndex="20"
                            Visibility="Collapsed"
                            ButtonBase.Click="ElementDrawer_Click">
                        <Grid>
                        <controls:GlassBackdrop Source="{Binding ElementName=CanvasScrollViewer}"
                                                TintKey="Brush.Glass.Acrylic"
                                                Radius="12"/>
                        <StackPanel Margin="8,10">
                            <TextBlock x:Name="TxtDrawerTitle"
                                       Style="{DynamicResource Text.Overline}"
                                       Margin="10,0,10,6"/>
                        <StackPanel x:Name="DrawerPassive" Visibility="Collapsed">
                            <Button x:Name="BtnAddResistor"
                                    Style="{DynamicResource Button.Nav}"
                                    Click="BtnAddResistor_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.Resistor}" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="Direnç" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnAddCapacitor"
                                    Style="{DynamicResource Button.Nav}"
                                    Click="BtnAddCapacitor_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.Capacitor}" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="Kondansatör" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnAddInductor"
                                    Style="{DynamicResource Button.Nav}"
                                    Click="BtnAddInductor_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.Inductor}" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="Bobin" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnAddImpedance"
                                    Style="{DynamicResource Button.Nav}"
                                    Click="BtnAddImpedance_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.Impedance}" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="Empedans" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnAddTransformer"
                                    Style="{DynamicResource Button.Nav}"
                                    Click="BtnAddTransformer_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.Transformer}" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="Transformatör" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnAddThreePhaseLoad"
                                    Style="{DynamicResource Button.Nav}"
                                    Click="BtnAddThreePhaseLoad_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.ThreePhaseLoad}" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="Üç fazlı yük" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="DrawerSources" Visibility="Collapsed">
                            <Button x:Name="BtnAddVoltageSource"
                                    Style="{DynamicResource Button.Nav}"
                                    Click="BtnAddVoltageSource_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.DcSource}" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="DC gerilim kaynağı" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnAddAcSource"
                                    Style="{DynamicResource Button.Nav}"
                                    Click="BtnAddAcSource_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.AcSource}" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="AC gerilim kaynağı" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnAddCurrentSource"
                                    Style="{DynamicResource Button.Nav}"
                                    Click="BtnAddCurrentSource_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.CurrentSource}" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="Akım kaynağı" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnAddAcCurrentSource"
                                    Style="{DynamicResource Button.Nav}"
                                    Click="BtnAddAcCurrentSource_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.AcCurrentSource}" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="AC akım kaynağı" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnAddThreePhaseSource"
                                    Style="{DynamicResource Button.Nav}"
                                    Click="BtnAddThreePhaseSource_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.ThreePhaseSource}" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="Üç fazlı kaynak" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnAddGround"
                                    Style="{DynamicResource Button.Nav}"
                                    Click="BtnAddGround_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.Ground}" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="Toprak (GND)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="DrawerDependent" Visibility="Collapsed">
                            <Button x:Name="BtnAddVcvs"
                                    Style="{DynamicResource Button.Nav}"
                                    ToolTip="Gerilim Kontrollü Gerilim Kaynağı (GKGK): çıkış gerilimi = kazanç · kontrol gerilimi. Devrede E1, E2… diye adlandırılır."
                                    Click="BtnAddVcvs_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.DepVcvs}" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="GKGK" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnAddVccs"
                                    Style="{DynamicResource Button.Nav}"
                                    ToolTip="Gerilim Kontrollü Akım Kaynağı (GKAK): çıkış akımı = kazanç · kontrol gerilimi. Devrede G1, G2… diye adlandırılır."
                                    Click="BtnAddVccs_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.DepVccs}" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="GKAK" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnAddCcvs"
                                    Style="{DynamicResource Button.Nav}"
                                    ToolTip="Akım Kontrollü Gerilim Kaynağı (AKGK): çıkış gerilimi = kazanç · kontrol akımı. Devrede H1, H2… diye adlandırılır."
                                    Click="BtnAddCcvs_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.DepCcvs}" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="AKGK" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnAddCccs"
                                    Style="{DynamicResource Button.Nav}"
                                    ToolTip="Akım Kontrollü Akım Kaynağı (AKAK): çıkış akımı = kazanç · kontrol akımı. Devrede F1, F2… diye adlandırılır."
                                    Click="BtnAddCccs_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.DepCccs}" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="AKAK" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="DrawerSwitches" Visibility="Collapsed">
                            <Button x:Name="BtnAddSwitch"
                                    Style="{DynamicResource Button.Nav}"
                                    ToolTip="Tek konumlu anahtar (t = 0'da kapanır veya açılır). Devrede S1, S2… diye adlandırılır."
                                    Click="BtnAddSwitch_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.Switch}" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="Anahtar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnAddSpdtSwitch"
                                    Style="{DynamicResource Button.Nav}"
                                    ToolTip="İki konumlu anahtar (t &lt; 0 ortak–1, t ≥ 0 ortak–2). Devrede S1, S2… diye adlandırılır."
                                    Click="BtnAddSpdtSwitch_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.SpdtSwitch}" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="İki konumlu anahtar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="DrawerMeasure" Visibility="Collapsed">
                            <Button x:Name="BtnAddProbe"
                                    Style="{DynamicResource Button.Nav}"
                                    Click="BtnAddProbe_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.Probe}" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="Ölçüm probu" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnAddWattmeter"
                                    Style="{DynamicResource Button.Nav}"
                                    Click="BtnAddWattmeter_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.Wattmeter}" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="Wattmetre" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Seçili elemanın cam kartı: akım, gerilim, güç, düğümdeki akım dengesi (DESIGN.md, "Akım ışığı") -->
                    <Border x:Name="ElementCard"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="248"
                            CornerRadius="14"
                            Effect="{DynamicResource Effect.Glass}"
                            IsHitTestVisible="False"
                            Panel.ZIndex="15"
                            Visibility="Collapsed">
                        <Grid>
                        <controls:GlassBackdrop Source="{Binding ElementName=CanvasScrollViewer}"
                                                Radius="14"/>
                        <StackPanel Margin="14,12">
                            <Grid Margin="0,0,0,6">
                                <TextBlock x:Name="TxtCardName" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                <TextBlock x:Name="TxtCardValue" FontSize="13" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Akım" FontSize="13" Margin="0,1,14,1" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                <TextBlock x:Name="TxtCardCurrent" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Margin="0,1"
                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                <TextBlock Grid.Row="1" Text="Yön" FontSize="13" Margin="0,1,14,1" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                <TextBlock x:Name="TxtCardDirection" Grid.Row="1" Grid.Column="1" FontSize="13" Margin="0,1"
                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                <TextBlock x:Name="LblCardVoltage" Grid.Row="2" Text="Gerilim" FontSize="13" Margin="0,1,14,1" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                <TextBlock x:Name="TxtCardVoltage" Grid.Row="2" Grid.Column="1" FontSize="13" Margin="0,1"
                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                <TextBlock x:Name="LblCardPower" Grid.Row="3" Text="Güç" FontSize="13" Margin="0,1,14,1" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                <TextBlock x:Name="TxtCardPower" Grid.Row="3" Grid.Column="1" FontSize="13" Margin="0,1"
                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                            </Grid>
                            <Border x:Name="CardBalanceRow" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0"
                                    BorderBrush="{DynamicResource Brush.Glass.Divider}">
                                <TextBlock x:Name="TxtCardBalance" FontSize="12" TextWrapping="Wrap" LineHeight="17"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            </Border>
                        </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Yüzen araç çubuğu (Floating Toolbar) -->
                    <Border x:Name="FloatingToolbar"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,14"
                            CornerRadius="16"
                            Effect="{DynamicResource Effect.Glass}"
                            Panel.ZIndex="10">
                        <Grid>
                        <controls:GlassBackdrop Source="{Binding ElementName=CanvasScrollViewer}"
                                                Radius="16"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5">
                            <Button x:Name="BtnDrawWire"
                                    Style="{DynamicResource Button.Ghost}"
                                    Height="32"
                                    ToolTip="Tel çiz (W)"
                                    Click="BtnDrawWire_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{DynamicResource Icon.Wire}" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtDrawWire" Text="Tel çiz" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="18"
                                    Background="{DynamicResource Brush.Glass.Divider}"
                                    Margin="4,0"/>

                            <Button x:Name="BtnUndo"
                                    Style="{DynamicResource Button.Icon}"
                                    Width="32" Height="32"
                                    AutomationProperties.Name="Geri al (Ctrl+Z)"
                                    ToolTip="Geri al (Ctrl+Z)"
                                    Click="BtnUndo_Click">
                                <controls:Icon Data="{DynamicResource Icon.Undo}" Width="16" Height="16"/>
                            </Button>

                            <Button x:Name="BtnRedo"
                                    Style="{DynamicResource Button.Icon}"
                                    Width="32" Height="32"
                                    AutomationProperties.Name="Yinele (Ctrl+Y)"
                                    ToolTip="Yinele (Ctrl+Y)"
                                    Click="BtnRedo_Click">
                                <controls:Icon Data="{DynamicResource Icon.Redo}" Width="16" Height="16"/>
                            </Button>

                            <Border Width="1" Height="18"
                                    Background="{DynamicResource Brush.Glass.Divider}"
                                    Margin="4,0"/>

                            <Button x:Name="BtnZoomOut"
                                    Style="{DynamicResource Button.Icon}"
                                    Width="32" Height="32"
                                    AutomationProperties.Name="Uzaklaştır"
                                    ToolTip="Uzaklaştır (Ctrl+-)"
                                    Click="BtnZoomOut_Click">
                                <controls:Icon Data="{DynamicResource Icon.ZoomOut}" Width="16" Height="16"/>
                            </Button>

                            <TextBlock x:Name="TxtZoomPercent"
                                       Text="100%"
                                       FontSize="13"
                                       Width="48"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Cursor="Hand"
                                       ToolTip="%100 yap (Ctrl+0)"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       MouseLeftButtonDown="TxtZoomPercent_MouseLeftButtonDown"/>

                            <Button x:Name="BtnZoomIn"
                                    Style="{DynamicResource Button.Icon}"
                                    Width="32" Height="32"
                                    AutomationProperties.Name="Yakınlaştır"
                                    ToolTip="Yakınlaştır (Ctrl++)"
                                    Click="BtnZoomIn_Click">
                                <controls:Icon Data="{DynamicResource Icon.ZoomIn}" Width="16" Height="16"/>
                            </Button>

                            <Button x:Name="BtnZoomFit"
                                    Style="{DynamicResource Button.Icon}"
                                    Width="32" Height="32"
                                    AutomationProperties.Name="Sığdır"
                                    ToolTip="Sığdır"
                                    Click="BtnZoomFit_Click">
                                <controls:Icon Data="{DynamicResource Icon.Fit}" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Durum satırı: 8x8 nokta + TxtStatus + TxtCoords -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,6,0,6">
                <Border Width="8" Height="8"
                        CornerRadius="4"
                        Background="{DynamicResource Brush.Text.Tertiary}"
                        VerticalAlignment="Center"
                        Margin="4,0,8,0"/>
                <TextBlock x:Name="TxtStatus"
                           Text="Hazır — soldaki şeritten bir eleman seçin"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           FontSize="13"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtCoords"
                           Text=""
                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════ -->
        <!-- SAĞ PANEL: ANALİZ (ayarlar + sonuçlar)     -->
        <!-- ═══════════════════════════════════════════ -->
        <views:AnalysisPanel x:Name="AnalysisPanel" Grid.Row="1" Grid.Column="3" Margin="0,0,0,8"/>

        <!-- Tuval ile Analiz paneli arasındaki ayırıcı: sürükleyerek paneli genişlet/daralt -->
        <GridSplitter x:Name="AnalysisSplitter"
                      Grid.Row="1"
                      Grid.Column="2"
                      Width="8"
                      Margin="0,0,0,8"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="False"
                      Style="{DynamicResource Splitter.Vertical}"
                      ToolTip="Sürükleyerek Analiz panelinin genişliğini ayarlayın"
                      AutomationProperties.Name="Analiz paneli genişliği"
                      DragCompleted="AnalysisSplitter_DragCompleted"/>
    </Grid>

    <!-- Tanıtım Turu Katmanı (Tüm pencerenin üzerinde) -->
    <views:TourOverlay x:Name="TourOverlay"
                       Panel.ZIndex="1000"
                       Visibility="Collapsed"/>

    <!-- In-Window Tanıtım Katmanı -->
    <views:OnboardingOverlay x:Name="OnboardingOverlay"
                             Panel.ZIndex="1100"
                             Visibility="Collapsed"/>

    <!-- In-Window Hakkında Katmanı -->
    <views:AboutOverlay x:Name="AboutOverlay"
                        Panel.ZIndex="1200"
                        Visibility="Collapsed"/>

    <!-- In-Window Genel Diyalog Katmanı (Kısayollar vb.) -->
    <views:DialogOverlay x:Name="DialogOverlay"
                         Panel.ZIndex="1300"
                         Visibility="Collapsed"/>

    <!-- In-Window Büyütülmüş Grafik Katmanı -->
    <views:PlotOverlay x:Name="PlotOverlay"
                       Panel.ZIndex="1400"
                       Visibility="Collapsed"/>
</Grid>
</Window>
