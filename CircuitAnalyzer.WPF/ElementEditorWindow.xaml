<Window x:Class="CircuitAnalyzer.WPF.ElementEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eleman Düzenle"
        Width="400" SizeToContent="Height"
        MinHeight="200" MaxHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        Icon="pack://application:,,,/CircuitAnalyzer;component/Assets/app.ico"
        Style="{DynamicResource Window.App}">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <TextBlock x:Name="TxtTitle"
                       Text="Eleman Düzenle"
                       Style="{DynamicResource Text.Section}"
                       Margin="0,0,0,16"/>

            <!-- Dinamik Alan (mod seçici + alanlar + önizleme) -->
            <StackPanel x:Name="PropertiesPanel"
                        Grid.Row="1"
                        Margin="0,0,0,16"/>

            <!-- Butonlar -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="İptal"
                        Style="{DynamicResource Button.Secondary}"
                        Click="BtnCancel_Click"
                        Margin="0,0,8,0"
                        IsCancel="True"/>
                <Button Content="Uygula"
                        Style="{DynamicResource Button.Primary}"
                        Click="BtnApply_Click"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
