<!--
    Koyu tema ("Gece") — renk belirteçleri. Light.xaml ile AYNI anahtarlar.
    Windows 11 koyu Mica tonları (#202020 zemin, #272727 kâğıt); vurgu açık mavi, üzerindeki yazı koyu
    (beyaz yazı açık mavi üstünde okunmaz).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Zeminler ── -->
    <SolidColorBrush x:Key="Brush.Bg.Window" Color="#202020"/>
    <SolidColorBrush x:Key="Brush.Bg.Surface" Color="#272727"/>
    <SolidColorBrush x:Key="Brush.Bg.SurfaceAlt" Color="#202020"/>
    <SolidColorBrush x:Key="Brush.Bg.Subtle" Color="#202020"/>
    <SolidColorBrush x:Key="Brush.Bg.Hover" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Brush.Bg.Pressed" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Bg.Selected" Color="#23324A"/>
    <SolidColorBrush x:Key="Brush.Bg.Input" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="Brush.Bg.Popup" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="Brush.Bg.Strong" Color="#F3F2EF"/>
    <SolidColorBrush x:Key="Brush.Bg.StrongHover" Color="#D7D6D3"/>

    <!-- ── Kenarlar ── -->
    <SolidColorBrush x:Key="Brush.Border.Card" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Border.Default" Color="#383838"/>
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#454545"/>
    <SolidColorBrush x:Key="Brush.Border.Focus" Color="#5AA9FF"/>

    <!-- ── Yazı ── -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F3F2EF"/>
    <SolidColorBrush x:Key="Brush.Text.Body" Color="#D7D6D3"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A6A5A3"/>
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#979694"/>
    <SolidColorBrush x:Key="Brush.Text.OnStrong" Color="#202020"/>

    <!-- ── Vurgu ── -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#5AA9FF"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#74B7FF"/>
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#4A98EE"/>
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#0A1A2F"/>
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#23324A"/>
    <SolidColorBrush x:Key="Brush.Accent.SoftText" Color="#A9D0FF"/>

    <!-- ── Durum renkleri ── -->
    <SolidColorBrush x:Key="Brush.Success" Color="#4ADE80"/>
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="#15291D"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#FBBF24"/>
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="#2E2410"/>
    <SolidColorBrush x:Key="Brush.Error" Color="#F87171"/>
    <SolidColorBrush x:Key="Brush.Error.Soft" Color="#2E1717"/>
    <SolidColorBrush x:Key="Brush.Info" Color="#A9D0FF"/>
    <SolidColorBrush x:Key="Brush.Info.Soft" Color="#23324A"/>

    <!-- ── Çizim alanı ve devre sembolleri ── -->
    <SolidColorBrush x:Key="Brush.Canvas.Bg" Color="#4D3A3A3A"/>
    <SolidColorBrush x:Key="Brush.Circuit.Stroke" Color="#E8E6E1"/>
    <SolidColorBrush x:Key="Brush.Circuit.Fill" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="Brush.Circuit.Label" Color="#F3F2EF"/>
    <SolidColorBrush x:Key="Brush.Circuit.LabelSecondary" Color="#A6A5A3"/>
    <SolidColorBrush x:Key="Brush.Circuit.Wire" Color="#CFCDC6"/>
    <SolidColorBrush x:Key="Brush.Circuit.WirePreview" Color="#995AA9FF"/>
    <SolidColorBrush x:Key="Brush.Circuit.Selection" Color="#5AA9FF"/>
    <SolidColorBrush x:Key="Brush.Circuit.SelectionFill" Color="#265AA9FF"/>
    <SolidColorBrush x:Key="Brush.Circuit.Pin" Color="#5AA9FF"/>
    <SolidColorBrush x:Key="Brush.Circuit.Source" Color="#E8E6E1"/>
    <SolidColorBrush x:Key="Brush.Circuit.Probe" Color="#FDBA74"/>

    <!-- ── Devre üzerindeki sonuç etiketleri ── -->
    <SolidColorBrush x:Key="Brush.Overlay.NodeBg" Color="#5AA9FF"/>
    <SolidColorBrush x:Key="Brush.Overlay.NodeText" Color="#0A1A2F"/>
    <SolidColorBrush x:Key="Brush.Overlay.BadgeBg" Color="#23324A"/>
    <SolidColorBrush x:Key="Brush.Overlay.BadgeText" Color="#A9D0FF"/>
    <SolidColorBrush x:Key="Brush.Overlay.Current" Color="#7DB8FF"/>
    <SolidColorBrush x:Key="Brush.Overlay.Probe" Color="#FDBA74"/>

    <!-- Tanıtım turu / pencere arkası karartma perdesi -->
    <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="#A6000000"/>

    <DrawingBrush x:Key="Brush.Canvas.Grid" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute"
                  Viewbox="0,0,20,20" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,20,20"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#26FFFFFF">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DropShadowEffect x:Key="Effect.Card" BlurRadius="0" ShadowDepth="0" Color="#000000" Opacity="0"/>
    <DropShadowEffect x:Key="Effect.Popup" BlurRadius="28" ShadowDepth="6" Direction="270"
                      Color="#000000" Opacity="0.45"/>

    <!-- Cam (DESIGN.md "Cam kuralları"): yalnız tuvalin üstünde yüzen parçalar -->
    <SolidColorBrush x:Key="Brush.Glass.Base" Color="#262626"/>
    <SolidColorBrush x:Key="Brush.Glass.Tint" Color="#66343438"/>
    <SolidColorBrush x:Key="Brush.Glass.Acrylic" Color="#8C2C2C2C"/>
    <SolidColorBrush x:Key="Brush.Glass.Divider" Color="#1AFFFFFF"/>
    <LinearGradientBrush x:Key="Brush.Glass.Edge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3DFFFFFF" Offset="0"/>
        <GradientStop Color="#14FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Effect.Glass" BlurRadius="28" ShadowDepth="8" Direction="270"
                      Color="#000000" Opacity="0.42"/>

</ResourceDictionary>
