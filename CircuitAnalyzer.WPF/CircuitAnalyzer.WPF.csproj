<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- GitHub'ın Linux üzerindeki otomatik bağımlılık taraması paketleri çözebilsin (Windows derlemesini etkilemez) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CircuitAnalyzer.WPF</RootNamespace>
    <AssemblyName>CircuitAnalyzer</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Programın sürümü TEK yerden: Hakkında penceresi ve kurulum paketi bunu kullanır.
         Yeni sürüm çıkarken yalnızca burayı değiştirin. -->
    <Version>1.4.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo-128.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WPF" Version="5.0.54" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CircuitAnalyzer.Tests" />
  </ItemGroup>

</Project>
