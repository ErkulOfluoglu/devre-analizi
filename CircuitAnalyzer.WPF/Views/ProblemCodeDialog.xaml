<Window x:Class="CircuitAnalyzer.WPF.Views.ProblemCodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soru Kodu"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/CircuitAnalyzer;component/Assets/app.ico"
        Style="{DynamicResource Window.App}">

    <Border Padding="24" MinWidth="360">
        <StackPanel>
            <TextBlock Text="Hocanızın verdiği 4 haneli soru kodunu yazın:"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,0,0,16"/>

            <TextBox x:Name="TxtCode"
                     Margin="0,0,0,16"/>

            <TextBlock x:Name="TxtError"
                       Foreground="{DynamicResource Brush.Error}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Visibility="Collapsed"
                       Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="BtnCancel"
                        Content="İptal"
                        IsCancel="True"
                        Style="{DynamicResource Button.Secondary}"
                        Margin="0,0,8,0"
                        Click="BtnCancel_Click"/>
                <Button x:Name="BtnOpen"
                        Content="Aç"
                        IsDefault="True"
                        Style="{DynamicResource Button.Primary}"
                        Click="BtnOpen_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
