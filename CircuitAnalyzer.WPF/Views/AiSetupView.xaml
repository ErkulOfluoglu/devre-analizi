<UserControl x:Class="CircuitAnalyzer.WPF.Views.AiSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CircuitAnalyzer.WPF.Controls"
             Background="Transparent"
             Unloaded="UserControl_Unloaded">
    <StackPanel>
        <!-- 2 Adımlı Kurulum Kartı -->
        <Border Style="{DynamicResource Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16">
            <StackPanel>
                <!-- Düşük bellek uyarısı (Fit == "low" olduğunda görünür) -->
                <Border x:Name="BannerLowMemory"
                        Style="{DynamicResource InfoBar.Warning}"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:Icon Data="{DynamicResource Icon.Warning}"
                                       Width="16" Height="16"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="Bu bilgisayarın belleği 8 GB'ın altında. Yapay zekâ yavaş çalışabilir; yine de kurup deneyebilirsiniz."
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 1. ADIM: Ollama Programı -->
                <Grid x:Name="RowStep1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Rozet / İkon: daire rozet "1" (Accent.Soft/SoftText) veya tik (Success.Soft/Success) -->
                    <Border x:Name="BadgeStep1"
                            Grid.Column="0"
                            Width="26" Height="26"
                            CornerRadius="13"
                            Background="{DynamicResource Brush.Accent.Soft}"
                            VerticalAlignment="Top"
                            Margin="0,0,12,0">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtBadgeStep1"
                                       Text="1"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Accent.SoftText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <controls:Icon x:Name="IconCheckStep1"
                                           Data="{DynamicResource Icon.Check}"
                                           Width="14" Height="14"
                                           Foreground="{DynamicResource Brush.Success}"
                                           Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Ollama programı"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                        <TextBlock x:Name="TxtStep1Caption"
                                   Text="Bulunamadı. Ücretsiz; her program gibi kurulur (İleri, İleri, Bitir)."
                                   Style="{DynamicResource Text.Caption}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Eylem butonu -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button x:Name="BtnInstallOllama"
                                Style="{DynamicResource Button.Primary}"
                                Height="36"
                                Content="Ollama'yı indir"
                                Padding="14,0"
                                Click="BtnInstallOllama_Click"/>
                        <Button x:Name="BtnStartOllama"
                                Style="{DynamicResource Button.Primary}"
                                Height="36"
                                Content="Başlat"
                                Padding="14,0"
                                Visibility="Collapsed"
                                Click="BtnStartOllama_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Ayırıcı Çizgi -->
                <Rectangle Height="1"
                           Fill="{DynamicResource Brush.Border.Default}"
                           Margin="0,14"/>

                <!-- 2. ADIM: Yapay Zekâ Modeli -->
                <Grid x:Name="RowStep2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Rozet "2" -->
                        <Border x:Name="BadgeStep2"
                                Grid.Column="0"
                                Width="26" Height="26"
                                CornerRadius="13"
                                Background="{DynamicResource Brush.Bg.Subtle}"
                                VerticalAlignment="Top"
                                Margin="0,0,12,0">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtBadgeStep2"
                                           Text="2"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <controls:Icon x:Name="IconCheckStep2"
                                               Data="{DynamicResource Icon.Check}"
                                               Width="14" Height="14"
                                               Foreground="{DynamicResource Brush.Success}"
                                               Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStep2Title"
                                       Text="Yapay zekâ modeli"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <TextBlock x:Name="TxtStep2Advice"
                                       Text="Belleğinize uygun model önerilir."
                                       Style="{DynamicResource Text.Caption}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- İndir / Yeniden dene butonu -->
                        <Button x:Name="BtnDownloadModel"
                                Grid.Column="2"
                                Style="{DynamicResource Button.Primary}"
                                Height="36"
                                Content="Modeli indir"
                                Padding="14,0"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Click="BtnDownloadModel_Click"/>
                    </Grid>

                    <!-- Disk Uyarısı (Yetersiz yer varsa) -->
                    <TextBlock x:Name="TxtDiskError"
                               Grid.Row="1"
                               Foreground="{DynamicResource Brush.Error}"
                               FontSize="12"
                               Margin="38,6,0,0"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <!-- İndirme İlerleme Alanı (downloading durumu) -->
                    <StackPanel x:Name="PanelDownloading"
                                Grid.Row="1"
                                Margin="38,10,0,0"
                                Visibility="Collapsed">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- İlerleme Çubuğu (8px track Brush.Border.Default, fill Brush.Accent, rounded) -->
                            <Border x:Name="TrackDownloadProgress"
                                    Grid.Column="0"
                                    Height="8"
                                    Background="{DynamicResource Brush.Border.Default}"
                                    CornerRadius="4"
                                    ClipToBounds="True"
                                    VerticalAlignment="Center">
                                <Border x:Name="BarDownloadProgress"
                                        HorizontalAlignment="Left"
                                        Width="0"
                                        Height="8"
                                        Background="{DynamicResource Brush.Accent}"
                                        CornerRadius="4"/>
                            </Border>

                            <Button x:Name="BtnCancelDownload"
                                    Grid.Column="1"
                                    Style="{DynamicResource Button.Secondary}"
                                    Height="28"
                                    Content="İptal"
                                    Padding="10,0"
                                    Margin="10,0,0,0"
                                    Click="BtnCancelDownload_Click"/>
                        </Grid>

                        <TextBlock x:Name="TxtDownloadProgressCaption"
                                   Text="%0 · İnerken programı kullanmaya devam edebilirsiniz."
                                   Style="{DynamicResource Text.Caption}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- İndirme Hatası / İptal Mesajı -->
                    <TextBlock x:Name="TxtPullMessage"
                               Grid.Row="1"
                               FontSize="12"
                               Margin="38,6,0,0"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </Grid>

                <!-- Hazır Durumu (InfoBar.Success) -->
                <Border x:Name="BannerReady"
                        Style="{DynamicResource InfoBar.Success}"
                        Margin="0,12,0,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:Icon Data="{DynamicResource Icon.Check}"
                                       Width="16" Height="16"
                                       Foreground="{DynamicResource Brush.Success}"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtReadyMessage"
                                   Text="Hazır — kurulu."
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Sistem Gereksinimleri Bloğu (Card.Inset) -->
        <Border Style="{DynamicResource Card.Inset}"
                Margin="0,12,0,0"
                Padding="14,12">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Sistem gereksinimleri"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"/>

                    <!-- Hap: "Bu bilgisayar: {RamGb:0} GB bellek — {model} önerilir" -->
                    <Border x:Name="PillRam"
                            Grid.Column="1"
                            Style="{DynamicResource Pill.Success}"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPillRam"
                                   Text="Bu bilgisayar: bellek kontrol ediliyor…"/>
                    </Border>
                </Grid>

                <!-- 3 sütunlu ızgara: Bellek (RAM) | Model | Durum -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Başlıklar -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Bellek (RAM)" Style="{DynamicResource Text.Caption}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Model" Style="{DynamicResource Text.Caption}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Durum" Style="{DynamicResource Text.Caption}" FontWeight="SemiBold"/>

                    <!-- Satır 1: 16 GB ve üstü -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="16 GB ve üstü" FontSize="12.5" Margin="0,4,0,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="gemma4:e4b · ≈7 GB disk" FontSize="12.5" Margin="0,4,0,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Rahat çalışır" Foreground="{DynamicResource Brush.Success}" FontSize="12.5" FontWeight="SemiBold" Margin="0,4,0,2"/>

                    <!-- Satır 2: 8 – 16 GB -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="8 – 16 GB" FontSize="12.5" Margin="0,2,0,2"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="gemma4:e2b · ≈5 GB disk" FontSize="12.5" Margin="0,2,0,2"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Çalışır, daha yavaş" Foreground="{DynamicResource Brush.Warning}" FontSize="12.5" FontWeight="SemiBold" Margin="0,2,0,2"/>

                    <!-- Satır 3: 8 GB altı -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="8 GB altı" FontSize="12.5" Margin="0,2,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="—" FontSize="12.5" Margin="0,2,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Önerilmez" Foreground="{DynamicResource Brush.Error}" FontSize="12.5" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </Grid>

                <TextBlock Text="Ekran kartı gerekmez; yapay zekâ işlemcide çalışır ve bir cevap 15–60 saniye sürebilir. Çalışırken bilgisayar yavaşlayabilir, diğer programları kapatmak iyi olur. Yapay zekâ olmadan da programın her özelliği çalışır."
                           Style="{DynamicResource Text.Caption}"
                           Margin="0,0,0,6"/>

                <TextBlock Text="Terminal gerekmez. Ollama kurulunca program bunu birkaç saniye içinde fark eder."
                           Style="{DynamicResource Text.Caption}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
