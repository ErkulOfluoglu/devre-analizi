<UserControl x:Class="CircuitAnalyzer.WPF.Views.AnalysisPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:CircuitAnalyzer.WPF.Controls"
             mc:Ignorable="d" 
             d:DesignWidth="380" d:DesignHeight="700"
             Background="Transparent">

    <!-- Okuma paneli (DESIGN.md, "Okuma paneli"): tek kâğıt — üstte yöntem ve Çöz,
         ortada adım adım çözüm, altta adımlar arası geçiş -->
    <Border x:Name="PaperCard"
            Style="{DynamicResource Card}"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Başlık: yöntem, Çöz, ayarlar -->
                <RowDefinition Height="Auto"/>
                <!-- Uyarı şeridi (devre değişti) -->
                <RowDefinition Height="Auto"/>
                <!-- Kaydırılabilir çözüm -->
                <RowDefinition Height="*"/>
                <!-- Adım geçişi -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="0,0,0,1"
                    Padding="20,14,20,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CmbAnalysisType"
                              AutomationProperties.Name="Yöntem"
                              VerticalAlignment="Center"
                              SelectedIndex="0"
                              SelectionChanged="CmbAnalysisType_SelectionChanged">
                        <ComboBoxItem Content="Düğüm Gerilimleri"/>
                        <ComboBoxItem Content="Thevenin Eşdeğeri"/>
                        <ComboBoxItem Content="Norton Eşdeğeri"/>
                        <ComboBoxItem Content="Çevre Akımları"/>
                        <ComboBoxItem Content="Süperpozisyon"/>
                        <ComboBoxItem Content="Millman"/>
                        <ComboBoxItem Content="Kaynak Dönüşümü"/>
                        <ComboBoxItem Content="Geçici Durum (Anahtar)"/>
                        <ComboBoxItem Content="Güç ve Güç Katsayısı" ToolTip="Devrenin aktif (P), reaktif (Q) ve görünür (S) gücü, güç faktörü ve kompanzasyon hesabı"/>
                        <ComboBoxItem Content="Rezonans" ToolTip="Seri veya paralel RLC devrelerinin rezonans frekansı, kalite faktörü, bant genişliği ve frekans eğrisi"/>
                        <ComboBoxItem Content="Transformatör" ToolTip="İdeal veya kuplajlı transformatör analizi"/>
                        <ComboBoxItem Content="Üç Faz" ToolTip="Üç fazlı devrelerin hat/faz gerilim ve akımları, güç ve kompanzasyon hesabı"/>
                    </ComboBox>

                    <Button x:Name="BtnSolve"
                            Grid.Column="1"
                            Style="{DynamicResource Button.Primary}"
                            Height="36"
                            FontSize="14"
                            Padding="18,0"
                            Margin="8,0,0,0"
                            Click="BtnSolve_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:Icon x:Name="IconSolve"
                                           Data="{DynamicResource Icon.Play}"
                                           Width="14" Height="14"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSolve"
                                       Text="Çöz"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSolveKey"
                                       Text="  F5"
                                       Opacity="0.8"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Mod, soru numarası ve çözücü durumu -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtModeLabel"
                                   Text="DC analiz"
                                   Style="{DynamicResource Text.Caption}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtProblemCode"
                                   Style="{DynamicResource Text.Caption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Accent.SoftText}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                    <Border x:Name="PillBackendStatus"
                            Grid.Column="1"
                            Style="{DynamicResource Pill.Neutral}"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtBackendStatus"
                                   Text="Çözücü başlatılıyor…"/>
                    </Border>
                </Grid>

                <!-- Soru Kodu Kartı (rastgele soru yüklenince) -->
                <Border x:Name="CardProblemCode"
                        Background="{DynamicResource Brush.Accent.Soft}"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,10,0,0"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtProblemCodeBig"
                                       Foreground="{DynamicResource Brush.Accent.SoftText}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Aynı soruyu öğrencilere vermek için bu kodu paylaşın: Yeni Soru → Soru koduyla aç"
                                       Style="{DynamicResource Text.Caption}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnCopyProblemCode"
                                Grid.Column="1"
                                Style="{DynamicResource Button.Secondary}"
                                Height="32"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Soru kodunu panoya kopyalar"
                                Click="BtnCopyProblemCode_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:Icon x:Name="IconCopyProblemCode"
                                               Data="{DynamicResource Icon.Copy}"
                                               Width="16" Height="16"
                                               Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtCopyProblemCode"
                                           Text="Kopyala"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Terminaller (Thevenin/Norton için) -->
                <Grid x:Name="RowTerminals"
                      Margin="0,8,0,0"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="+ terminal"
                                   Style="{DynamicResource Text.Caption}"
                                   Margin="0,0,0,2"/>
                        <ComboBox x:Name="CmbTerminalPositive"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="− terminal"
                                   Style="{DynamicResource Text.Caption}"
                                   Margin="0,0,0,2"/>
                        <ComboBox x:Name="CmbTerminalNegative"/>
                    </StackPanel>
                </Grid>

                <!-- Frekans (AC için) -->
                <StackPanel x:Name="RowFrequency"
                            Margin="0,8,0,0"
                            Visibility="Collapsed">
                    <TextBlock x:Name="TxtFrequencyLabel"
                               Text="Frekans (Hz) — gerekli"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtFrequency"/>
                </StackPanel>

                <!-- Hedef cos φ (Güç analizi için) -->
                <StackPanel x:Name="RowPowerFactorTarget"
                            Margin="0,8,0,0"
                            Visibility="Collapsed">
                    <TextBlock x:Name="TxtPowerFactorTargetLabel"
                               Text="Hedef cos φ (isteğe bağlı)"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtPowerFactorTarget"/>
                </StackPanel>

                <!-- Değer Gösterimi (AC için: Etkin / Tepe) -->
                <StackPanel x:Name="RowValueDisplay"
                            Margin="0,8,0,0"
                            Visibility="Collapsed">
                    <TextBlock Text="Sonuçlar"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,0,0,4"/>
                    <Border Style="{DynamicResource Segment.Track}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="BtnDisplayRms"
                                          Grid.Column="0"
                                          Content="Etkin"
                                          Style="{DynamicResource Segment.Item}"
                                          Click="BtnDisplayRms_Click"/>
                            <ToggleButton x:Name="BtnDisplayPeak"
                                          Grid.Column="1"
                                          Content="Tepe"
                                          Style="{DynamicResource Segment.Item}"
                                          Click="BtnDisplayPeak_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Alıştırma modu switch -->
                <CheckBox x:Name="ChkPracticeMode"
                          Style="{DynamicResource CheckBox.Switch}"
                          Margin="0,10,0,0"
                          ToolTip="Açıkken Çöz'e basınca sonuçlar gizlenir; soruları kendiniz çözüp cevaplarınızı kontrol edersiniz.">
                    <StackPanel>
                        <TextBlock Text="Alıştırma modu" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Önce kendim çözeceğim" Style="{DynamicResource Text.Caption}"/>
                    </StackPanel>
                </CheckBox>

            </StackPanel>
            </Border>

            <!-- Uyarı şeridi (devre değişti) -->
            <Border x:Name="BannerStale"
                    Grid.Row="1"
                    Style="{DynamicResource InfoBar.Warning}"
                    Margin="20,12,20,0"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:Icon Data="{DynamicResource Icon.Warning}"
                                   Width="16" Height="16"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                    <TextBlock Text="Devre değişti — sonuçları güncellemek için tekrar Çöz'e basın"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Çözüm (kaydırılabilir) -->
            <ScrollViewer x:Name="ResultsScrollViewer"
                          Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="ResultsScrollViewer_ScrollChanged">
                <StackPanel x:Name="ResultsContainer" Margin="28,22,24,24"/>
            </ScrollViewer>

            <!-- Adımlar arası geçiş: bölüme kaydırır, çözümü sayfalara bölmez -->
            <Border x:Name="StepNavBar"
                    Grid.Row="3"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="0,1,0,0"
                    Padding="14,8"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnPrevStep"
                            Style="{DynamicResource Button.Ghost}"
                            Height="32"
                            AutomationProperties.Name="Önceki adım"
                            Click="BtnPrevStep_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="‹" FontSize="16" Margin="0,-2,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Önceki" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="TxtStepLabel"
                               Grid.Column="1"
                               Style="{DynamicResource Text.Caption}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="8,0"/>
                    <Button x:Name="BtnNextStep"
                            Grid.Column="2"
                            Style="{DynamicResource Button.Ghost}"
                            Height="32"
                            AutomationProperties.Name="Sonraki adım"
                            Click="BtnNextStep_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sonraki" VerticalAlignment="Center"/>
                            <TextBlock Text="›" FontSize="16" Margin="6,-2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
