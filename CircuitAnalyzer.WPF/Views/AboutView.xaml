<UserControl x:Class="CircuitAnalyzer.WPF.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CircuitAnalyzer.WPF.Controls">

    <StackPanel Margin="0,0,6,0">
        <!-- Logo + Başlık + Sürüm -->
        <Image Source="pack://application:,,,/CircuitAnalyzer;component/Assets/logo-128.png"
               Width="64" Height="64"
               Margin="0,0,0,10"
               HorizontalAlignment="Center"/>

        <TextBlock Text="Devre Analizi"
                   FontFamily="{DynamicResource Font.Display}"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Text.Primary}"
                   TextAlignment="Center"
                   Margin="0,0,0,4"/>

        <TextBlock x:Name="TxtVersion"
                   Style="{DynamicResource Text.Caption}"
                   TextAlignment="Center"
                   Margin="0,0,0,14"/>

        <!-- Açıklama -->
        <TextBlock Text="Elektronik öğrencileri için ücretsiz, açık kaynak devre analizi programı. Devreyi çizin; program kesin olarak çözer ve her adımı Türkçe anlatır."
                   Style="{DynamicResource Text.Body}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   LineHeight="20"
                   Margin="0,0,0,18"/>

        <!-- Sorumluluk Reddi (InfoBar.Warning) -->
        <Border Style="{DynamicResource InfoBar.Warning}" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <controls:Icon Data="{DynamicResource Icon.Warning}"
                                   Width="16" Height="16"
                                   Foreground="{DynamicResource Brush.Warning}"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                    <TextBlock Text="Sorumluluk reddi"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Warning}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TxtDisclaimer"
                           Text="Bu program bilgi paylaşımı ve eğitim amacıyla hazırlanmıştır. Olduğu gibi sunulur; doğruluğu, eksiksizliği veya belirli bir amaca uygunluğu konusunda hiçbir garanti verilmez. Sonuçları kendiniz kontrol edin. Programın kullanımından doğabilecek her türlü sonuçtan kullanıcı sorumludur; geliştirici sorumlu tutulamaz. Bu koşulları kabul etmiyorsanız programı kullanmayın."
                           Style="{DynamicResource Text.Caption}"
                           TextWrapping="Wrap"
                           LineHeight="18"/>
            </StackPanel>
        </Border>

        <!-- Gizlilik -->
        <TextBlock Text="Gizlilik"
                   Style="{DynamicResource Text.Section}"
                   Margin="0,0,0,6"/>
        <TextBlock Text="Program internete bağlanmaz ve hiçbir kişisel veri toplamaz. İsteğe bağlı yapay zekâ tamamen bu bilgisayarda çalışır; internet yalnızca Ollama'yı ve modeli indirirken kullanılır."
                   Style="{DynamicResource Text.Body}"
                   TextWrapping="Wrap"
                   LineHeight="19"
                   Margin="0,0,0,16"/>

        <!-- Lisans -->
        <TextBlock Text="Lisans"
                   Style="{DynamicResource Text.Section}"
                   Margin="0,0,0,6"/>
        <TextBlock x:Name="TxtLicense"
                   Style="{DynamicResource Text.Body}"
                   TextWrapping="Wrap"
                   LineHeight="19"
                   Margin="0,0,0,16"/>

        <!-- Kullanılan açık kaynak bileşenler -->
        <TextBlock Text="Kullanılan açık kaynak bileşenler"
                   Style="{DynamicResource Text.Section}"
                   Margin="0,0,0,8"/>

        <Border Style="{DynamicResource Card.Inset}" Padding="12,10" Margin="0,0,0,10">
            <Grid x:Name="GridComponents">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Başlıklar -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Bileşen" Style="{DynamicResource Text.Caption}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Lisans" Style="{DynamicResource Text.Caption}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Not" Style="{DynamicResource Text.Caption}" FontWeight="SemiBold" Margin="0,0,0,6"/>

                <Border Grid.Row="1" Grid.ColumnSpan="3" Height="1" Background="{DynamicResource Brush.Border.Default}" Margin="0,0,0,8"/>

                <!-- 1. .NET / WPF -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text=".NET / WPF" Style="{DynamicResource Text.Body}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="MIT" Style="{DynamicResource Text.Caption}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="—" Style="{DynamicResource Text.Caption}" Margin="0,0,0,6"/>

                <!-- 2. Python -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Python" Style="{DynamicResource Text.Body}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="PSF" Style="{DynamicResource Text.Caption}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="—" Style="{DynamicResource Text.Caption}" Margin="0,0,0,6"/>

                <!-- 3. FastAPI -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="FastAPI" Style="{DynamicResource Text.Body}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="MIT" Style="{DynamicResource Text.Caption}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="—" Style="{DynamicResource Text.Caption}" Margin="0,0,0,6"/>

                <!-- 4. Pydantic -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Pydantic" Style="{DynamicResource Text.Body}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="MIT" Style="{DynamicResource Text.Caption}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="5" Grid.Column="2" Text="—" Style="{DynamicResource Text.Caption}" Margin="0,0,0,6"/>

                <!-- 5. Uvicorn -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Uvicorn" Style="{DynamicResource Text.Body}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Text="BSD-3-Clause" Style="{DynamicResource Text.Caption}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="6" Grid.Column="2" Text="—" Style="{DynamicResource Text.Caption}" Margin="0,0,0,6"/>

                <!-- 6. lcapy -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="lcapy" Style="{DynamicResource Text.Body}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="7" Grid.Column="1" Text="LGPL-2.1 veya üstü" Style="{DynamicResource Text.Caption}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="7" Grid.Column="2" Style="{DynamicResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,6">
                    <Run Text="Değiştirilmeden kullanılır · "/>
                    <Hyperlink NavigateUri="https://github.com/mph-/lcapy" RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="kaynak kodu"/>
                    </Hyperlink>
                    <Run Text=" · "/>
                    <Hyperlink NavigateUri="https://www.gnu.org/licenses/old-licenses/lgpl-2.1.html" RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="LGPL 2.1 metni"/>
                    </Hyperlink>
                </TextBlock>

                <!-- 7. SymPy -->
                <TextBlock Grid.Row="8" Grid.Column="0" Text="SymPy" Style="{DynamicResource Text.Body}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="8" Grid.Column="1" Text="BSD-3-Clause" Style="{DynamicResource Text.Caption}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="8" Grid.Column="2" Text="—" Style="{DynamicResource Text.Caption}" Margin="0,0,0,6"/>

                <!-- 8. NumPy -->
                <TextBlock Grid.Row="9" Grid.Column="0" Text="NumPy" Style="{DynamicResource Text.Body}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="9" Grid.Column="1" Text="BSD-3-Clause" Style="{DynamicResource Text.Caption}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="9" Grid.Column="2" Text="—" Style="{DynamicResource Text.Caption}" Margin="0,0,0,6"/>

                <!-- 9. mpmath -->
                <TextBlock Grid.Row="10" Grid.Column="0" Text="mpmath" Style="{DynamicResource Text.Body}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="10" Grid.Column="1" Text="BSD-3-Clause" Style="{DynamicResource Text.Caption}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="10" Grid.Column="2" Text="—" Style="{DynamicResource Text.Caption}" Margin="0,0,0,6"/>

                <!-- 10. NetworkX -->
                <TextBlock Grid.Row="11" Grid.Column="0" Text="NetworkX" Style="{DynamicResource Text.Body}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="11" Grid.Column="1" Text="BSD-3-Clause" Style="{DynamicResource Text.Caption}" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="11" Grid.Column="2" Text="—" Style="{DynamicResource Text.Caption}" Margin="0,0,0,6"/>

                <!-- 11. Starlette -->
                <TextBlock Grid.Row="12" Grid.Column="0" Text="Starlette" Style="{DynamicResource Text.Body}" Margin="0,0,0,2"/>
                <TextBlock Grid.Row="12" Grid.Column="1" Text="BSD-3-Clause" Style="{DynamicResource Text.Caption}" Margin="0,0,0,2"/>
                <TextBlock Grid.Row="12" Grid.Column="2" Text="—" Style="{DynamicResource Text.Caption}" Margin="0,0,0,2"/>
                <!-- 12. ScottPlot -->
                <TextBlock Grid.Row="13" Grid.Column="0" Text="ScottPlot" Style="{DynamicResource Text.Body}" Margin="0,0,0,2"/>
                <TextBlock Grid.Row="13" Grid.Column="1" Text="MIT" Style="{DynamicResource Text.Caption}" Margin="0,0,0,2"/>
                <TextBlock Grid.Row="13" Grid.Column="2" Style="{DynamicResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,2">
                    <Run Text="Değiştirilmeden kullanılır · "/>
                    <Hyperlink NavigateUri="https://github.com/ScottPlot/ScottPlot" RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="kaynak kodu"/>
                    </Hyperlink>
                    <Run Text=" · "/>
                    <Hyperlink NavigateUri="https://github.com/ScottPlot/ScottPlot/blob/main/LICENSE" RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="MIT lisans metni"/>
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </Border>

        <!-- İsteğe bağlı bileşenler açıklaması ve bağlantılar -->
        <TextBlock Style="{DynamicResource Text.Caption}" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0">
            <Run Text="İsteğe bağlı, programla birlikte DAĞITILMAYAN: "/>
            <Hyperlink NavigateUri="https://github.com/ollama/ollama/blob/main/LICENSE" RequestNavigate="Hyperlink_RequestNavigate">
                <Run Text="Ollama (MIT)"/>
            </Hyperlink>
            <Run Text=" · "/>
            <Hyperlink NavigateUri="https://ai.google.dev/gemma/terms" RequestNavigate="Hyperlink_RequestNavigate">
                <Run Text="Gemma 4 modeli (Apache 2.0)"/>
            </Hyperlink>
            <Run Text=". Bunları kullanıcı kendisi kurar; kendi lisans koşulları geçerlidir."/>
        </TextBlock>
        <TextBlock Style="{DynamicResource Text.Caption}" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0"
                   Text="Tüm bileşenlerin tam listesi ve lisans metinleri, programın kurulu olduğu klasördeki “licenses” klasöründe ve THIRD_PARTY_NOTICES.md dosyasındadır."/>
    </StackPanel>
</UserControl>
