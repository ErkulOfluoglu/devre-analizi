<UserControl x:Class="CircuitAnalyzer.WPF.Views.AboutOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CircuitAnalyzer.WPF.Views"
             Focusable="True"
             FocusVisualStyle="{x:Null}">

    <Grid x:Name="OverlayRoot">
        <!-- Karartma perdesi: tıklamaların arkaya geçmesini engeller -->
        <Border x:Name="Scrim"
                Background="{DynamicResource Brush.Overlay.Scrim}"
                MouseLeftButtonDown="Scrim_MouseDown"
                MouseRightButtonDown="Scrim_MouseDown"/>

        <!-- Ortalanmış kart -->
        <Border x:Name="CardBorder"
                Style="{DynamicResource Card}"
                Background="{DynamicResource Brush.Bg.Surface}"
                CornerRadius="22"
                Effect="{DynamicResource Effect.Popup}"
                Width="700"
                Padding="28,24,28,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonDown="Card_MouseDown"
                MouseRightButtonDown="Card_MouseDown">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- İçerik alanı: Pencere küçükse kaydırılabilir -->
                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <views:AboutView x:Name="AboutContent"/>
                </ScrollViewer>

                <!-- Kapat Butonu -->
                <Button x:Name="BtnClose"
                        Grid.Row="1"
                        Content="Kapat"
                        Style="{DynamicResource Button.Primary}"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0"
                        Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
