<UserControl x:Class="CircuitAnalyzer.WPF.Views.TransientPlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CircuitAnalyzer.WPF.Controls"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Üst çubuk: Başlık, Seçiciler, Büyüt düğmesi -->
            <RowDefinition Height="Auto"/>
            <!-- Üst grafik: Gerilim (veya seçilen büyüklük) -->
            <RowDefinition Height="*"/>
            <!-- Alt grafik: Akım (veya seçilen büyüklük) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık ve Kontroller -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:Icon Data="{DynamicResource Icon.Pulse}"
                                   Width="16" Height="16"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtHeaderTitle"
                               Text="Zaman Grafiği"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTauInfo"
                               Style="{DynamicResource Text.Caption}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Çoklu büyüklük seçici (yalnızca 2'den fazla büyüklük varsa görünür) -->
                <Grid x:Name="RowSelectors" Margin="0,6,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Üst:" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1" x:Name="CmbTopQuantity" SelectionChanged="CmbTopQuantity_SelectionChanged"/>

                    <TextBlock Grid.Column="3" Text="Alt:" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="4" x:Name="CmbBottomQuantity" SelectionChanged="CmbBottomQuantity_SelectionChanged"/>
                </Grid>
            </StackPanel>

            <!-- Büyüt düğmesi (küçük kartta görünür, büyütülmüş pencerede gizlenir) -->
            <Button Grid.Column="1"
                    x:Name="BtnEnlarge"
                    Style="{DynamicResource Button.Secondary}"
                    Padding="10,4"
                    VerticalAlignment="Top"
                    ToolTip="Grafiği büyüt"
                    Click="BtnEnlarge_Click">
                <StackPanel Orientation="Horizontal">
                    <controls:Icon Data="{DynamicResource Icon.Fit}" Width="14" Height="14" Margin="0,0,6,0"/>
                    <TextBlock Text="Büyüt" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Üst Grafik (Gerilim) -->
        <Border Grid.Row="1"
                Style="{DynamicResource Card.Inset}"
                Padding="2"
                Margin="0,0,0,6"
                MinHeight="140">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TxtHoverTop"
                           Grid.Row="0"
                           Style="{DynamicResource Text.Caption}"
                           FontFamily="{DynamicResource Font.Mono}"
                           Margin="6,2,6,0"
                           HorizontalAlignment="Right"/>
                <sp:WpfPlot x:Name="PlotTop"
                            Grid.Row="1"
                            MouseMove="PlotTop_MouseMove"
                            MouseLeave="PlotTop_MouseLeave"/>
            </Grid>
        </Border>

        <!-- Alt Grafik (Akım) -->
        <Border Grid.Row="2"
                Style="{DynamicResource Card.Inset}"
                Padding="2"
                MinHeight="140">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TxtHoverBottom"
                           Grid.Row="0"
                           Style="{DynamicResource Text.Caption}"
                           FontFamily="{DynamicResource Font.Mono}"
                           Margin="6,2,6,0"
                           HorizontalAlignment="Right"/>
                <sp:WpfPlot x:Name="PlotBottom"
                            Grid.Row="1"
                            MouseMove="PlotBottom_MouseMove"
                            MouseLeave="PlotBottom_MouseLeave"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
