<UserControl x:Class="CircuitAnalyzer.WPF.Views.DialogOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             FocusVisualStyle="{x:Null}">

    <!--
        Pencere içi genel diyalog kartı (Kısayollar vb.).
        Hakkında ve Tanıtım katmanlarıyla aynı görünüm: karartma perdesi + ortalanmış kart.
    -->
    <Grid>
        <!-- Karartma perdesi: tıklamaların arkaya geçmesini engeller -->
        <Border Background="{DynamicResource Brush.Overlay.Scrim}"
                MouseLeftButtonDown="Absorb_MouseDown"
                MouseRightButtonDown="Absorb_MouseDown"/>

        <Border x:Name="CardBorder"
                Style="{DynamicResource Card}"
                Background="{DynamicResource Brush.Bg.Surface}"
                CornerRadius="22"
                Effect="{DynamicResource Effect.Popup}"
                Width="520"
                Padding="28,24,28,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonDown="Absorb_MouseDown"
                MouseRightButtonDown="Absorb_MouseDown">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleText"
                           Style="{DynamicResource Text.Title}"
                           Margin="0,0,0,16"/>

                <!-- İçerik: pencere küçükse kaydırılır -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <ContentPresenter x:Name="BodyHost"/>
                </ScrollViewer>

                <Button x:Name="BtnOk"
                        Grid.Row="2"
                        Content="Tamam"
                        Style="{DynamicResource Button.Primary}"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0"
                        Click="BtnOk_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
