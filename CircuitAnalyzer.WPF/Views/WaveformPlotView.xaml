<UserControl x:Class="CircuitAnalyzer.WPF.Views.WaveformPlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CircuitAnalyzer.WPF.Controls"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Üst çubuk: Başlık ve Büyüt düğmesi -->
            <RowDefinition Height="Auto"/>
            <!-- Grafik -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <controls:Icon Data="{DynamicResource Icon.Pulse}"
                               Width="16" Height="16"
                               Foreground="{DynamicResource Brush.Accent}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtHeaderTitle"
                           Text="Dalga Şekli Grafiği"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="1"
                    x:Name="BtnEnlarge"
                    Style="{DynamicResource Button.Secondary}"
                    Padding="10,4"
                    VerticalAlignment="Top"
                    ToolTip="Grafiği büyüt"
                    Click="BtnEnlarge_Click">
                <StackPanel Orientation="Horizontal">
                    <controls:Icon Data="{DynamicResource Icon.Fit}" Width="14" Height="14" Margin="0,0,6,0"/>
                    <TextBlock Text="Büyüt" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1"
                Style="{DynamicResource Card.Inset}"
                Padding="2"
                MinHeight="200">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TxtHover"
                           Grid.Row="0"
                           Style="{DynamicResource Text.Caption}"
                           FontFamily="{DynamicResource Font.Mono}"
                           Margin="6,2,6,0"
                           HorizontalAlignment="Right"/>
                <sp:WpfPlot x:Name="PlotWaveform"
                            Grid.Row="1"
                            MouseMove="PlotWaveform_MouseMove"
                            MouseLeave="PlotWaveform_MouseLeave"
                            SizeChanged="PlotWaveform_SizeChanged"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
