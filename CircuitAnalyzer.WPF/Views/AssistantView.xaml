<UserControl x:Class="CircuitAnalyzer.WPF.Views.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:CircuitAnalyzer.WPF.Views"
             xmlns:controls="clr-namespace:CircuitAnalyzer.WPF.Controls"
             mc:Ignorable="d" 
             d:DesignWidth="360"
             Background="Transparent">

    <Expander x:Name="AssistantExpander"
              Style="{DynamicResource Expander.Card}"
              IsExpanded="False"
              Margin="0,4,0,8"
              Expanded="AssistantExpander_Expanded">
        <Expander.Header>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:Icon Data="{DynamicResource Icon.Sparkle}"
                               Foreground="{DynamicResource Brush.Accent}"
                               Width="18" Height="18"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                <TextBlock Text="Yapay zekâya sor"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Text=" (isteğe bağlı)"
                           Style="{DynamicResource Text.Caption}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Expander.Header>

        <StackPanel Margin="0,6,0,0">
            <!-- 1. Durum Satırı -->
            <TextBlock x:Name="TxtStatusLine"
                       Text="Yapay zekâ aranıyor…"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,0,0,6"/>

            <!-- Tekrar dene butonu -->
            <Button x:Name="BtnRetry"
                    Content="Tekrar dene"
                    Style="{DynamicResource Button.Secondary}"
                    Height="32"
                    Padding="12,0"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8"
                    Visibility="Collapsed"
                    Click="BtnRetry_Click"/>

            <!-- Yapay zekâ hazır değilken kurulum sihirbazı -->
            <views:AiSetupView x:Name="SetupWizard"
                               Margin="0,2,0,8"
                               Visibility="Collapsed"/>

            <!-- Model ve çalıştığı yer (ekran kartı / işlemci / NPU) -->
            <Grid x:Name="RowModel" Margin="0,0,0,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Model:"
                           Style="{DynamicResource Text.Caption}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbModel"
                          Grid.Column="1"
                          AutomationProperties.Name="Model"
                          SelectionChanged="CmbModel_SelectionChanged"/>

                <TextBlock x:Name="LblDevice"
                           Grid.Row="1"
                           Text="Çalıştığı yer:"
                           Style="{DynamicResource Text.Caption}"
                           VerticalAlignment="Center"
                           Margin="0,8,8,0"/>
                <ComboBox x:Name="CmbDevice"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,8,0,0"
                          AutomationProperties.Name="Çalıştığı yer"
                          SelectionChanged="CmbDevice_SelectionChanged">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                            <Setter Property="IsEnabled" Value="{Binding Available}"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding Display}"/>
                            <Setter Property="AutomationProperties.HelpText" Value="{Binding Note}"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Display}"/>
                                <TextBlock x:Name="Note"
                                           Text="{Binding Note}"
                                           Style="{DynamicResource Text.Caption}"
                                           TextWrapping="Wrap"
                                           MaxWidth="320"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <!-- Seçili kutuda (açılır listenin dışında) yalnız ad görünür -->
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                                    <Setter TargetName="Note" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel x:Name="RowPlacement"
                            Grid.Row="2"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="2,6,0,0"
                            Visibility="Collapsed">
                    <Ellipse x:Name="DotPlacement"
                             Width="8" Height="8"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource Brush.Success}"/>
                    <TextBlock x:Name="TxtPlacement"
                               Style="{DynamicResource Text.Caption}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Tümleşik ekran kartı: Ollama'yı ayarla yeniden başlatma onayı -->
            <Border x:Name="GpuRestartBar"
                    Style="{DynamicResource InfoBar.Warning}"
                    Margin="0,0,0,8"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="TxtGpuRestart"
                               Text="Ollama bu ekran kartını kendiliğinden kullanmıyor. Ekran kartı ayarıyla yeniden başlatılsın mı? Ayar yalnız program açıkken geçerlidir; Windows ayarlarınız değişmez."
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="BtnGpuRestart"
                                Content="Yeniden başlat"
                                Style="{DynamicResource Button.Primary}"
                                Height="32"
                                Padding="12,0"
                                Click="BtnGpuRestart_Click"/>
                        <Button x:Name="BtnGpuCancel"
                                Content="Vazgeç"
                                Style="{DynamicResource Button.Secondary}"
                                Height="32"
                                Padding="12,0"
                                Margin="8,0,0,0"
                                Click="BtnGpuCancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. Alıştırma Uyarısı -->
            <Border x:Name="PracticeNotice"
                    Style="{DynamicResource InfoBar.Warning}"
                    Margin="0,0,0,8"
                    Visibility="Collapsed">
                <TextBlock Text="Alıştırma sürüyor: yapay zekâ yalnızca yol gösterir, cevapları söylemez."
                           TextWrapping="Wrap"/>
            </Border>

            <!-- 3. Öneri Butonları -->
            <WrapPanel x:Name="SuggestionsContainer" Margin="0,0,0,8"/>

            <!-- 4. Sohbet Listesi -->
            <ScrollViewer x:Name="ChatScrollViewer"
                          MaxHeight="280"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,8">
                <StackPanel x:Name="ChatContainer"/>
            </ScrollViewer>

            <!-- 5. Hata Mesajı Alanı -->
            <TextBlock x:Name="TxtError"
                       Foreground="{DynamicResource Brush.Error}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Visibility="Collapsed"/>

            <!-- 6. Düşünülüyor / İptal Satırı -->
            <Grid x:Name="RowBusy" Margin="0,0,0,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtBusy"
                           Text="Düşünüyor… (işlemcide 1 dakikayı bulabilir)"
                           Style="{DynamicResource Text.Caption}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button x:Name="BtnCancel"
                        Grid.Column="1"
                        Content="İptal"
                        Style="{DynamicResource Button.Ghost}"
                        Height="32"
                        Padding="12,0"
                        Margin="8,0,0,0"
                        Click="BtnCancel_Click"/>
            </Grid>

            <!-- 7. Girdi Satırı -->
            <Grid x:Name="RowInput" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtQuestion"
                         MinHeight="40"
                         MaxHeight="80"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         PreviewKeyDown="TxtQuestion_PreviewKeyDown"/>
                <Button x:Name="BtnSend"
                        Grid.Column="1"
                        Style="{DynamicResource Button.Primary}"
                        Height="40"
                        Width="44"
                        Padding="0"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Gönder"
                        ToolTip="Gönder"
                        Click="BtnSend_Click">
                    <controls:Icon Data="{DynamicResource Icon.Send}"
                                   Width="18" Height="18"/>
                </Button>
            </Grid>

            <!-- 8. Alt Bilgi / Sorumluluk Reddi -->
            <TextBlock Text="Yapay zekâ hata yapabilir. Asıl çözüm Anlatım bölümündedir; cevaptaki sayılar programın çözümüyle karşılaştırılır."
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,2,0,2"/>
        </StackPanel>
    </Expander>
</UserControl>
