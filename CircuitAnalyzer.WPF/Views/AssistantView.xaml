<UserControl x:Class="CircuitAnalyzer.WPF.Views.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:CircuitAnalyzer.WPF.Views"
             xmlns:controls="clr-namespace:CircuitAnalyzer.WPF.Controls"
             mc:Ignorable="d" 
             d:DesignWidth="360"
             Background="Transparent">

    <Expander x:Name="AssistantExpander"
              Style="{DynamicResource Expander.Card}"
              IsExpanded="False"
              Margin="0,4,0,8"
              Expanded="AssistantExpander_Expanded">
        <Expander.Header>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:Icon Data="{DynamicResource Icon.Sparkle}"
                               Foreground="{DynamicResource Brush.Accent}"
                               Width="18" Height="18"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                <TextBlock Text="Yapay zekâya sor"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Text=" (isteğe bağlı)"
                           Style="{DynamicResource Text.Caption}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Expander.Header>

        <StackPanel Margin="0,6,0,0">
            <!-- 1. Durum Satırı -->
            <TextBlock x:Name="TxtStatusLine"
                       Text="Yapay zekâ aranıyor…"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,0,0,6"/>

            <!-- Tekrar dene butonu -->
            <Button x:Name="BtnRetry"
                    Content="Tekrar dene"
                    Style="{DynamicResource Button.Secondary}"
                    Height="32"
                    Padding="12,0"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8"
                    Visibility="Collapsed"
                    Click="BtnRetry_Click"/>

            <!-- Yapay zekâ hazır değilken kurulum sihirbazı -->
            <views:AiSetupView x:Name="SetupWizard"
                               Margin="0,2,0,8"
                               Visibility="Collapsed"/>

            <!-- Model Seçici -->
            <Grid x:Name="RowModel" Margin="0,0,0,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Model:"
                           Style="{DynamicResource Text.Caption}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbModel"
                          Grid.Column="1"
                          SelectionChanged="CmbModel_SelectionChanged"/>
            </Grid>

            <!-- 2. Alıştırma Uyarısı -->
            <Border x:Name="PracticeNotice"
                    Style="{DynamicResource InfoBar.Warning}"
                    Margin="0,0,0,8"
                    Visibility="Collapsed">
                <TextBlock Text="Alıştırma sürüyor: yapay zekâ yalnızca yol gösterir, cevapları söylemez."
                           TextWrapping="Wrap"/>
            </Border>

            <!-- 3. Öneri Butonları -->
            <WrapPanel x:Name="SuggestionsContainer" Margin="0,0,0,8"/>

            <!-- 4. Sohbet Listesi -->
            <ScrollViewer x:Name="ChatScrollViewer"
                          MaxHeight="280"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,8">
                <StackPanel x:Name="ChatContainer"/>
            </ScrollViewer>

            <!-- 5. Hata Mesajı Alanı -->
            <TextBlock x:Name="TxtError"
                       Foreground="{DynamicResource Brush.Error}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Visibility="Collapsed"/>

            <!-- 6. Düşünülüyor / İptal Satırı -->
            <Grid x:Name="RowBusy" Margin="0,0,0,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Düşünüyor… (işlemcide 1 dakikayı bulabilir)"
                           Style="{DynamicResource Text.Caption}"
                           VerticalAlignment="Center"/>
                <Button x:Name="BtnCancel"
                        Grid.Column="1"
                        Content="İptal"
                        Style="{DynamicResource Button.Ghost}"
                        Height="32"
                        Padding="12,0"
                        Margin="8,0,0,0"
                        Click="BtnCancel_Click"/>
            </Grid>

            <!-- 7. Girdi Satırı -->
            <Grid x:Name="RowInput" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtQuestion"
                         MinHeight="40"
                         MaxHeight="80"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         PreviewKeyDown="TxtQuestion_PreviewKeyDown"/>
                <Button x:Name="BtnSend"
                        Grid.Column="1"
                        Style="{DynamicResource Button.Primary}"
                        Height="40"
                        Width="44"
                        Padding="0"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Gönder"
                        ToolTip="Gönder"
                        Click="BtnSend_Click">
                    <controls:Icon Data="{DynamicResource Icon.Send}"
                                   Width="18" Height="18"/>
                </Button>
            </Grid>

            <!-- 8. Alt Bilgi / Sorumluluk Reddi -->
            <TextBlock Text="Yapay zekâ hata yapabilir. Asıl çözüm Anlatım bölümündedir; cevaptaki sayılar programın çözümüyle karşılaştırılır."
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,2,0,2"/>
        </StackPanel>
    </Expander>
</UserControl>
